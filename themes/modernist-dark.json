{
  "$schema": "echocad-theme/1",
  "id": "modernist-dark",
  "name": "Modernist Dark",
  "appearance": "dark",
  "_comment": "EchoCAD's default look: near-black neutrals, one red accent, Archivo type, square-ish corners. Every value here can be overridden by a theme that `extends` this one — see docs/THEMING.md.",

  "palette": {
    "ink-0":   "#0b0a0a",
    "ink-1":   "#0f0e0e",
    "ink-2":   "#151414",
    "ink-3":   "#1a1919",
    "ink-4":   "#1f1e1e",
    "ink-5":   "#242322",
    "ink-6":   "#33312f",
    "paper-1": "#6f6b6a",
    "paper-2": "#8c8887",
    "paper-3": "#bdb9b8",
    "paper-4": "#dedbda",
    "paper-5": "#f0edeb",
    "white":   "#ffffff",
    "red-500": "#ec3013",
    "red-400": "#ff563c",
    "red-300": "#ffb2a4",
    "green":   "#7fc97f",
    "blue":    "#6f9fd8",
    "salmon":  "#e05a4a",
    "amber":   "#ffb840",
    "violet":  "#b88cf2",
    "magenta": "#d973d9"
  },

  "colors": {
    "window_bg":     "@ink-2",
    "titlebar":      "@ink-1",
    "menubar":       "@ink-3",
    "ribbon":        "@ink-4",
    "panel":         "@ink-3",
    "panel_header":  "@ink-4",
    "panel_alt":     "#1d1c1c",
    "field":         "#131212",
    "hud":           "@ink-3*0.9",
    "border":        "@ink-0",
    "border_soft":   "@white*0.08",
    "divider":       "@white*0.07",

    "btn":                "@white*0.0",
    "btn_border":         "@white*0.0",
    "btn_hover":          "@white*0.07",
    "btn_hover_border":   "@white*0.09",
    "btn_pressed":        "@red-500*0.14",
    "btn_pressed_border": "@red-500*0.33",
    "btn_pressed_text":   "@red-300",

    "text":        "@paper-4",
    "text_strong": "@white",
    "text_dim":    "@paper-2",
    "text_faint":  "@paper-1",
    "icon":        "@paper-3",

    "accent":       "@red-500",
    "accent_hover": "@red-400",
    "accent_text":  "@red-300",
    "on_accent":    "@white",
    "selection":    "@red-500*0.09",

    "success":    "@green",
    "success_bg": "#1e2a1e",
    "warning":    "#e5a13f",
    "error":      "#de6358",

    "bg3d":          "#232222",
    "ambient":       "#a6a3a1",
    "sketch_bg":     "@ink-5",
    "grid_minor":    "@white*0.06",
    "grid_major":    "@white*0.10",
    "sk_grid_minor": "@white*0.05",
    "sk_grid_major": "@white*0.09",
    "axis_x":        "@salmon",
    "axis_y":        "@green",
    "axis_z":        "@blue",
    "plane":         "#8ca6d9*0.10",
    "plane_hover":   "#8cbfff*0.28",
    "body":          "#aaa6a3",
    "body_selected": "@amber",
    "body_edge":     "@ink-3",
    "view_cube":     "#ececea",
    "view_cube_text": "#2a2827",
    "view_cube_nav":  "#c4c0bd",
    "hover":         "#ffe08c*0.35",

    "ink_free":            "@paper-5",
    "ink_constrained":     "@green",
    "ink_construction":    "@violet",
    "ink_projected":       "@magenta",
    "ink_reference":       "#73808c*0.55",
    "region_fill":         "@red-500*0.10",
    "dim_line":            "#eae7e6",
    "dim_driven":          "#a6a29e",
    "constraint_ok":       "@green",
    "constraint_unsolved": "#c2c6cf",
    "constraint_redundant":"#d9a040",
    "constraint_conflict": "#de6358",
    "constraint_selected": "#ffd94d"
  },

  "fonts": {
    "ui": "res://assets/fonts/Archivo.ttf",
    "weight_regular": 500,
    "weight_bold": 600,
    "weight_heading": 700
  },

  "font_sizes": {
    "body": 12,
    "small": 11,
    "label": 10,
    "caption": 9,
    "title": 14
  },

  "metrics": {
    "radius": 3,
    "radius_small": 2,
    "border_width": 1,
    "menubar_height": 26,
    "ribbon_height": 84,
    "big_button_w": 64,
    "big_button_h": 64,
    "small_button_w": 48,
    "small_button_h": 44,
    "browser_width": 238,
    "row_height": 22,
    "hud_height": 30,
    "timeline_height": 52,
    "timeline_chip_w": 52,
    "status_height": 24,
    "icon_big": 36,
    "icon_small": 24,
    "icon_row": 14,
    "title_height": 28
  }
}
